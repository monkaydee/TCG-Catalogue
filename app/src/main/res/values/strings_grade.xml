    <string name="grade_check_outline">The green box shows the measured print frame, red boxes show wear. If the outline is off, retake the photo.</string>

    <string name="grade_tips_title">For an accurate result</string>
    <string name="grade_tip_sleeve">Take the card out of its sleeve or toploader.</string>
    <string name="grade_tip_background">Lay it on a plain, dark, matte surface.</string>
    <string name="grade_tip_light">Use soft, even light without reflections on the card.</string>
    <string name="grade_tip_straight">Hold the phone straight above the card, so the card fills most of the photo.</string>

    <string name="grade_problem_blurry">The photo is blurry — hold still and tap to focus before taking it.</string>
    <string name="grade_problem_glare">There are reflections on the card — tilt the light or the card a little.</string>
    <string name="grade_problem_small">The card is small in the photo — move the phone closer.</string>

