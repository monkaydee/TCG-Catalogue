<resources>
    <style name="Theme.TcgCatalogue" parent="Theme.AppCompat.DayNight.NoActionBar" />

    <!-- Shown by the system while the app starts; hands over to Theme.TcgCatalogue afterwards. -->
    <style name="Theme.TcgCatalogue.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.TcgCatalogue</item>
    </style>
</resources>
