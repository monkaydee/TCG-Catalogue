    <string name="settings_games">Games</string>
    <string name="settings_games_hint">The scanner looks for these games. Dragon Ball, Union Arena, Weiss Schwarz and Naruto download a card list (up to a few MB, refreshed daily).</string>
    <!-- Add recognised cards to the collection automatically, without a confirmation step -->
    <string name="settings_quick_add">Quick add while scanning</string>
    <string name="settings_quick_add_hint">Adds clearly recognised cards without asking, so you can scan a stack quickly.</string>
