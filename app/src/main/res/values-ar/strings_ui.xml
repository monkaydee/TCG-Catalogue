    <string name="settings_games">الألعاب</string>
    <string name="settings_games_hint">يبحث الماسح عن هذه الألعاب. تقوم Dragon Ball وUnion Arena وWeiss Schwarz وNaruto بتنزيل قائمة بطاقات (حتى بضعة ميغابايت، تُحدَّث يوميًا).</string>
