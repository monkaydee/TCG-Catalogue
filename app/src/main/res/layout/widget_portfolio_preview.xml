<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_preview_background" android:gravity="center_vertical"
    android:orientation="vertical" android:padding="18dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/app_name" android:textAllCaps="true" android:fontFamily="@font/inter_bold"
        android:textColor="#F2F7F6" android:textSize="9sp" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp"
        android:text="@string/widget_title" android:fontFamily="@font/inter_regular"
        android:textColor="#C6D0CE" android:textSize="11sp" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp"
        android:text="@string/widget_preview_value" android:fontFamily="@font/inter_bold"
        android:textColor="#F2F7F6" android:textSize="33sp" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:text="@string/widget_preview_change" android:fontFamily="@font/inter_regular"
        android:textColor="#C6D0CE" android:textSize="11sp" />
    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="14dp"
        android:layout_marginBottom="10dp" android:background="#405553" />
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/widget_preview_cards" android:fontFamily="@font/inter_regular"
        android:textColor="#C6D0CE" android:textSize="10sp" />
</LinearLayout>
