    <plurals name="data_graded_sales_count">
        <item quantity="other">%1$d件の販売</item>
    </plurals>

    <!-- Card page panel -->
    <string name="graded_title">鑑定品の価格</string>
    <string name="graded_none">このカードの鑑定品の販売は見つかりませんでした。</string>
    <string name="graded_failed">現在、価格サーバーに接続できません。</string>
