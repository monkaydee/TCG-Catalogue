        <item quantity="other">確認待ちのカード：%d枚 — タップして確認</item>
    </plurals>
    <string name="stack_tap_to_review">タップして確認</string>
    <string name="stack_undo">元に戻す</string>
    <string name="stack_discard">破棄</string>

