    <string name="crash_title">申し訳ありません、アプリがクラッシュしました</string>
    <string name="crash_text">技術レポートが保存されました（アプリとAndroidのバージョン、端末機種、エラー内容。カード情報は含まれません）。問題の修正に役立てるため送信できます。</string>
    <string name="crash_report_github">GitHubで報告</string>
    <string name="crash_share">共有</string>
