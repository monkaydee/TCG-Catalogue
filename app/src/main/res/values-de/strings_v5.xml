<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Price alerts (notifications) -->
    <string name="alert_channel">Preisalarme</string>
    <!-- %1$s = current value per copy, %2$s = the alert price -->
    <string name="alert_above">Jetzt %1$s — über deinem Alarm bei %2$s</string>
    <string name="alert_below">Jetzt %1$s — unter deinem Alarm bei %2$s</string>
    <!-- A card on the wishlist reached the price the user wants to pay -->
    <string name="alert_wish">Auf deiner Wunschliste: jetzt %1$s — höchstens dein Zielpreis von %2$s</string>

    <!-- Stack mode: scan many cards one after another without confirming each -->
    <string name="stack_mode">Stapelmodus</string>
    <!-- %1$s = card name; it couldn't be identified for sure and waits for the user -->
    <string name="stack_review_later">%1$s — prüfe sie später in der Leiste unten</string>
    <plurals name="stack_to_review">
        <item quantity="one">%d Karte zu prüfen — tippe darauf</item>
        <item quantity="other">%d Karten zu prüfen — tippe darauf</item>
    </plurals>
    <string name="stack_tap_to_review">Zum Prüfen tippen</string>
    <string name="stack_undo">Rückgängig</string>
    <string name="stack_discard">Verwerfen</string>

    <!-- Sealed products: unopened booster boxes, packs, decks, Elite Trainer Boxes … -->
    <string name="sealed_title">Versiegelte Produkte</string>
    <string name="sealed_add">Versiegeltes Produkt hinzufügen</string>
    <string name="sealed_value">Wert versiegelt</string>
    <plurals name="sealed_count">
        <item quantity="one">%d Artikel</item>
        <item quantity="other">%d Artikel</item>
    </plurals>
    <string name="sealed_empty">Verwalte hier ungeöffnete Booster-Boxen, Packs, Decks und Boxen. Ihr Marktwert zählt zu deinem Portfolio.</string>
    <string name="sealed_remove_hint">Speichern mit 0 entfernt das Produkt.</string>
    <!-- %1$s = signed amount, e.g. +12.00 € -->
    <string name="sealed_gain">%1$s seit dem Kauf</string>
    <string name="sealed_no_price">kein Preis</string>
    <string name="sealed_search_hint">Produktname oder Set, z. B. „151 Booster-Box“</string>
    <string name="sealed_no_results">Keine versiegelten Produkte gefunden</string>

    <!-- Shown at the start after the app crashed -->
    <string name="crash_title">Entschuldigung, die App ist abgestürzt</string>
    <string name="crash_text">Ein technischer Bericht wurde gespeichert (App- und Android-Version, Smartphone-Modell und der Fehler — keine deiner Karten). Du kannst ihn senden, um bei der Fehlerbehebung zu helfen.</string>
    <string name="crash_report_github">Auf GitHub melden</string>
    <string name="crash_share">Teilen</string>
    <string name="crash_dismiss">Nicht jetzt</string>

    <!-- Cloud backup: another phone saved a newer collection to the shared backup file -->
    <string name="home_cloud_newer_title">Neuere Sammlung von einem anderen Smartphone</string>
    <string name="home_cloud_newer_text">Dein Cloud-Backup wurde auf einem anderen Smartphone aktualisiert. Tippe, um es in den Einstellungen zu laden oder zusammenzuführen.</string>

    <!-- Find a card by its picture alone, when its number can't be read -->
    <string name="picture_find">Per Bild suchen</string>
    <string name="picture_preparing">Bildsuche wird vorbereitet — einmaliger Download von etwa 20 MB…</string>
    <string name="picture_searching">Karte wird anhand des Bilds gesucht…</string>
    <string name="picture_none">Keine Karte anhand des Bilds gefunden — versuche, sie einzutippen.</string>
    <string name="picture_unavailable">Die Bildsuche ist gerade nicht verfügbar — prüfe deine Verbindung.</string>
    <string name="picture_check">Anhand des Bilds gefunden — prüfe bitte, ob es die richtige Karte ist.</string>
</resources>
