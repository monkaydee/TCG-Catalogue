    <string name="sealed_no_price">tanpa harga</string>
    <string name="sealed_search_hint">Nama produk atau set, mis. “151 booster box”</string>
    <string name="sealed_no_results">Produk segel tidak ditemukan</string>

    <!-- Shown at the start after the app crashed -->
    <string name="crash_title">Maaf, aplikasi mengalami crash</string>
    <string name="crash_text">Laporan teknis telah disimpan (versi aplikasi dan Android, model ponsel, serta error — bukan kartu Anda). Anda dapat mengirimnya untuk membantu memperbaiki masalah.</string>
    <string name="crash_report_github">Laporkan di GitHub</string>
    <string name="crash_share">Bagikan</string>
    <string name="crash_dismiss">Nanti saja</string>

    <!-- Cloud backup: another phone saved a newer collection to the shared backup file -->
    <string name="home_cloud_newer_title">Koleksi lebih baru dari ponsel lain</string>
    <string name="home_cloud_newer_text">Cadangan cloud Anda diperbarui di ponsel lain. Ketuk untuk memuat atau menggabungkannya di Pengaturan.</string>

