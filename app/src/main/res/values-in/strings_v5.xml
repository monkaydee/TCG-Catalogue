    <string name="picture_find">Cari dengan gambar</string>
    <string name="picture_preparing">Menyiapkan pencarian gambar — unduhan satu kali sekitar 20 MB…</string>
    <string name="picture_searching">Mencari kartu dari gambarnya…</string>
    <string name="picture_none">Tidak ada kartu yang cocok dengan gambarnya — coba ketik manual.</string>
    <string name="picture_unavailable">Pencarian gambar belum tersedia saat ini — periksa koneksi Anda.</string>
    <string name="picture_check">Ditemukan lewat gambar — pastikan ini kartu yang benar.</string>
