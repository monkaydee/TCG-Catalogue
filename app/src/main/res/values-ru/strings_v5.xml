<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Price alerts (notifications) -->
    <string name="alert_channel">Ценовые уведомления</string>
    <!-- %1$s = current value per copy, %2$s = the alert price -->
    <string name="alert_above">Сейчас %1$s — выше вашего порога %2$s</string>
    <string name="alert_below">Сейчас %1$s — ниже вашего порога %2$s</string>
    <!-- A card on the wishlist reached the price the user wants to pay -->
    <string name="alert_wish">В списке желаний: сейчас %1$s — не выше вашей цели %2$s</string>

    <!-- Stack mode: scan many cards one after another without confirming each -->
    <string name="stack_mode">Режим стопки</string>
    <!-- %1$s = card name; it couldn't be identified for sure and waits for the user -->
    <string name="stack_review_later">%1$s — проверьте позже в ленте ниже</string>
    <plurals name="stack_to_review">
        <item quantity="one">%d карту нужно проверить — нажмите на неё</item>
        <item quantity="few">%d карты нужно проверить — нажмите на них</item>
        <item quantity="many">%d карт нужно проверить — нажмите на них</item>
        <item quantity="other">%d карты нужно проверить — нажмите на них</item>
    </plurals>
    <string name="stack_tap_to_review">Нажмите, чтобы проверить</string>
    <string name="stack_undo">Отменить</string>
    <string name="stack_discard">Удалить</string>

    <!-- Sealed products: unopened booster boxes, packs, decks, Elite Trainer Boxes … -->
    <string name="sealed_title">Запечатанные товары</string>
    <string name="sealed_add">Добавить запечатанный товар</string>
    <string name="sealed_value">Стоимость запечатанных</string>
    <plurals name="sealed_count">
        <item quantity="one">%d товар</item>
        <item quantity="few">%d товара</item>
        <item quantity="many">%d товаров</item>
        <item quantity="other">%d товара</item>
    </plurals>
    <string name="sealed_empty">Учитывайте здесь нераспечатанные бустер-боксы, паки, колоды и коробки. Их рыночная стоимость входит в ваш портфель.</string>
    <string name="sealed_remove_hint">Если сохранить с 0, товар будет удалён.</string>
    <!-- %1$s = signed amount, e.g. +12.00 € -->
    <string name="sealed_gain">%1$s с момента покупки</string>
    <string name="sealed_no_price">нет цены</string>
    <string name="sealed_search_hint">Название товара или сет, например «151 booster box»</string>
    <string name="sealed_no_results">Запечатанные товары не найдены</string>

    <!-- Shown at the start after the app crashed -->
    <string name="crash_title">Извините, приложение вылетело</string>
    <string name="crash_text">Сохранён технический отчёт (версии приложения и Android, модель телефона и ошибка — без ваших карт). Вы можете отправить его, чтобы помочь исправить проблему.</string>
    <string name="crash_report_github">Сообщить на GitHub</string>
    <string name="crash_share">Поделиться</string>
    <string name="crash_dismiss">Не сейчас</string>

    <!-- Cloud backup: another phone saved a newer collection to the shared backup file -->
    <string name="home_cloud_newer_title">Более новая коллекция с другого телефона</string>
    <string name="home_cloud_newer_text">Облачная копия обновлена на другом телефоне. Нажмите, чтобы загрузить или объединить её в настройках.</string>

    <!-- Find a card by its picture alone, when its number can't be read -->
    <string name="picture_find">Найти по картинке</string>
    <string name="picture_preparing">Подготовка поиска по картинке — однократная загрузка около 20 МБ…</string>
    <string name="picture_searching">Ищем карту по картинке…</string>
    <string name="picture_none">Карта по картинке не найдена — попробуйте ввести вручную.</string>
    <string name="picture_unavailable">Поиск по картинке сейчас недоступен — проверьте подключение.</string>
    <string name="picture_check">Найдено по картинке — проверьте, та ли это карта.</string>
</resources>
