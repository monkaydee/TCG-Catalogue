    <string name="settings_backup_title">बैकअप</string>
    <string name="settings_backup_hint">आपका कलेक्शन सिर्फ़ इसी फ़ोन में सेव रहता है। ऐप अनइंस्टॉल करने या फ़ोन बदलने से पहले बैकअप एक्सपोर्ट कर लें।</string>
