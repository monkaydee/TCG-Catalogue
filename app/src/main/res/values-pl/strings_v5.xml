<resources>
    <!-- Price alerts (notifications) -->
    <string name="alert_channel">Alerty cenowe</string>
    <!-- %1$s = current value per copy, %2$s = the alert price -->
    <string name="alert_above">Teraz %1$s — powyżej twojego alertu na %2$s</string>
    <string name="alert_below">Teraz %1$s — poniżej twojego alertu na %2$s</string>
    <!-- A card on the wishlist reached the price the user wants to pay -->
    <string name="alert_wish">Na twojej liście życzeń: teraz %1$s — na poziomie lub poniżej ceny docelowej %2$s</string>

    <!-- Stack mode: scan many cards one after another without confirming each -->
    <string name="stack_mode">Tryb stosu</string>
