    <string name="sealed_no_results">Nie znaleziono produktów zapieczętowanych</string>

    <!-- Shown at the start after the app crashed -->
    <string name="crash_title">Przepraszamy, aplikacja uległa awarii</string>
    <string name="crash_text">Zapisano raport techniczny (wersja aplikacji i Androida, model telefonu oraz błąd — bez żadnych twoich kart). Możesz go wysłać, aby pomóc naprawić problem.</string>
    <string name="crash_report_github">Zgłoś na GitHubie</string>
    <string name="crash_share">Udostępnij</string>
    <string name="crash_dismiss">Nie teraz</string>

    <!-- Cloud backup: another phone saved a newer collection to the shared backup file -->
    <string name="home_cloud_newer_title">Nowsza kolekcja z innego telefonu</string>
    <string name="home_cloud_newer_text">Twoja kopia zapasowa w chmurze została zaktualizowana na innym telefonie. Dotknij, aby wczytać ją lub scalić w Ustawieniach.</string>

