        <item quantity="other">%d karty do sprawdzenia — dotknij ich</item>
    </plurals>
    <string name="stack_tap_to_review">Dotknij, aby sprawdzić</string>
    <string name="stack_undo">Cofnij</string>
    <string name="stack_discard">Odrzuć</string>

    <!-- Sealed products: unopened booster boxes, packs, decks, Elite Trainer Boxes … -->
    <string name="sealed_title">Produkty zapieczętowane</string>
    <string name="sealed_add">Dodaj produkt zapieczętowany</string>
    <string name="sealed_value">Wartość zapieczętowanych</string>
