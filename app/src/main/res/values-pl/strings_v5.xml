    <string name="picture_none">Nie znaleziono karty po obrazie — spróbuj wpisać ją ręcznie.</string>
    <string name="picture_unavailable">Wyszukiwanie po obrazie jest teraz niedostępne — sprawdź połączenie.</string>
    <string name="picture_check">Znaleziono po obrazie — sprawdź, czy to właściwa karta.</string>
