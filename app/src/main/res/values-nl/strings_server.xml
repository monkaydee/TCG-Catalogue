    <plurals name="data_graded_sales_count">
        <item quantity="one">%1$d verkoop</item>
        <item quantity="other">%1$d verkopen</item>
    </plurals>

    <!-- Card page panel -->
    <string name="graded_title">Graded prijzen</string>
    <string name="graded_none">Geen graded verkopen gevonden voor deze kaart.</string>
    <string name="graded_failed">De prijsserver is nu niet bereikbaar.</string>
