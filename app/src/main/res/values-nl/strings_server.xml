<resources>
    <!-- ==== The app's own price server (graded prices, PSA certs, online identification) ==== -->

    <!-- Shown in brackets after "No graded price found"; %1$s = the grade, e.g. "PSA 10" -->
    <string name="data_graded_no_sales">geen recente verkopen van %1$s gevonden — stel je eigen waarde in of bekijk de prijslinks</string>
    <string name="data_graded_server_error">de prijsserver is nu niet bereikbaar</string>
